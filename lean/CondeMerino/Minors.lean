-- Each of the twelve graph evaluations is independently derived above.
theorem chain_coefficients (i : Fin 6) :
    lineCoeffs (openEdges i) = (squarePolys i).1 ∧
    lineCoeffs (closedEdges i) = (squarePolys i).2 :=
  match i with
  | ⟨0, _⟩ => ⟨c383, c66⟩
  | ⟨1, _⟩ => ⟨c424, c435⟩
  | ⟨2, _⟩ => ⟨c453, c494⟩
  | ⟨3, _⟩ => ⟨c521, c613⟩
  | ⟨4, _⟩ => ⟨c649, c813⟩
  | ⟨5, _⟩ => ⟨c862, c415⟩

